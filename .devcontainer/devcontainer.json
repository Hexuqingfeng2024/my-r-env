{
    "name": "RStudio Cloud",
    "dockerFile": "Dockerfile",
    "forwardPorts": [8787],
    "postStartCommand": "rstudio-server restart",
    "remoteUser": "root",
    "portsAttributes": {
        "8787": {
            "label": "RStudio IDE",
            "onAutoForward": "openBrowser",
            "visibility": "public"
        }
    }
}
